# コピーして .env として使用してください: cp .env.example .env
#
# PostgreSQL接続文字列。ローカル開発では `npx prisma dev` で起動したローカルDB、
# または任意のPostgreSQL（Docker等）を指定してください。
# 本番（Vercel）では Vercel Postgres / Neon / Supabase 等の接続文字列を
# Vercelプロジェクトの環境変数 DATABASE_URL に設定してください。
DATABASE_URL="postgresql://postgres:postgres@localhost:51214/template1?sslmode=disable"
